# Public browser configuration. Safe to expose in the Sites build.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Local Convex CLI configuration. CONVEX_DEPLOY_KEY is a secret.
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_DEPLOY_KEY=dev:your-deployment-name|your-secret-token

# Server-only secrets. Configure these in the Convex deployment as well.
OPENAI_API_KEY=
JAMBASE_API_KEY=

# Optional V1+ song recognition. Create an ACRCloud Audio & Video Recognition
# project using the "Recorded Audio" source and the ACRCloud Music bucket.
# Keep all three values in Convex only; never prefix them with VITE_.
ACRCLOUD_HOST=identify-us-west-2.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
