!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Expo
/.expo/
/mobile/.expo/
/.expo-shared/
/mobile/.expo-shared/
/web-build/
